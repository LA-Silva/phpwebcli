<?bop
/**
 * example.bop — Comprehensive showcase of BOP language constructs and
 * custom CLI functions available in this release.
 *
 * How to run from the browser BOP CLI (bop > prompt):
 *   $includeBop('example.bop');
 *
 * Or using the remote include alias:
 *   $include_remote('example.bop');
 */

echo "=== 1. Output & Tags ===\n";
echo "Hello from echo!\n";
print "Hello from print!\n";

echo "\n=== 2. Variables, Scope, Constants & Magic Constants ===\n";
$greeting = "BOPWebCLI";
$varName = "greeting";
echo "Variable variable: " . $$varName . "\n";

$orig = 10;
$ref = &$orig;
$ref += 5;
echo "Reference (&): orig={$orig}, ref={$ref}\n";

$globalCounter = 100;
if (!function_exists('demoScope')) {
	function demoScope() {
		global $globalCounter;
		static $calls = 0;
		$calls++;
		$globalCounter++;
		echo "Scope: global={$globalCounter}, static calls={$calls}\n";
	}
}
demoScope();
demoScope();

$temp = "defined";
echo "isset=" . (isset($temp) ? "true" : "false") . ", empty=" . (empty($temp) ? "true" : "false") . "\n";
unset($temp);
echo "after unset isset=" . (isset($temp) ? "true" : "false") . "\n";

if (!defined('APP_RELEASE')) {
	define('APP_RELEASE', '1.0');
}
echo "const APP_RELEASE=" . APP_RELEASE . ", __LINE__=" . __LINE__ . "\n";

echo "\n=== 3. Data Types, Strings, Arrays & Casting ===\n";
$intVal = 42;
$floatVal = 3.14;
$boolVal = true;
$nullVal = null;

$single = 'Single quoted: $intVal stays literal';
$double = "Double quoted: intVal={$intVal}, floatVal={$floatVal}";
echo $single . "\n" . $double . "\n";

$heredoc = <<<EOT
Heredoc string with interpolation: APP_RELEASE=1.0, intVal=$intVal
EOT;
$nowdoc = <<<'EOT'
Nowdoc string without interpolation: $intVal stays literal
EOT;
echo $heredoc . "\n" . $nowdoc . "\n";

$fruits = ['apple', 'banana'];
$fruits[] = 'cherry';
$assoc = array('host' => 'localhost', 'port' => 3000);
list($firstFruit, $secondFruit) = $fruits;
echo "Arrays & list(): {$firstFruit}, {$secondFruit}; port={$assoc['port']}\n";

echo "Casts: (int)'42px'=" . (int)'42px' . ", (float)'3.5'=" . (float)'3.5' . ", (string)99=" . (string)99 . "\n";

echo "\n=== 4. Operators & Expressions ===\n";
$a = 12;
$b = 5;
echo "Arithmetic: +=" . ($a + $b) . ", -=" . ($a - $b) . ", *=" . ($a * $b) . ", %=" . ($a % $b) . "\n";
echo "Bitwise: &=" . ($a & $b) . ", |=" . ($a | $b) . ", ^=" . ($a ^ $b) . ", <<=" . ($b << 1) . "\n";
echo "Comparison: 5=='5' is " . ((5 == '5') ? 'true' : 'false') . ", 5==='5' is " . ((5 === '5') ? 'true' : 'false') . "\n";
echo "Logical && / || / !: " . ((true && !false) ? 'true' : 'false') . ", " . ((false || true) ? 'true' : 'false') . "\n";
echo "Ternary & Null Coalesce: " . ($nullVal ?? 'fallback') . ", " . ($boolVal ? 'yes' : 'no') . "\n";
$safe = @$undefinedVar;
echo "Suppressed (@) undefined var is null: " . ($safe === null ? 'true' : 'false') . "\n";

echo "\n=== 5. Control Flow & Error Handling ===\n";
$score = 85;
if ($score >= 90) {
	echo "Grade: A\n";
} elseif ($score >= 80) {
	echo "Grade: B\n";
} else {
	echo "Grade: C\n";
}

switch ($score) {
	case 100:
		echo "Perfect!\n";
		break;
	default:
		echo "Switch default matched score={$score}\n";
}

$sum = 0;
for ($i = 1; $i <= 5; $i++) {
	if ($i === 3) {
		continue;
	}
	$sum += $i;
}
$w = 0;
while ($w < 2) {
	$w++;
}
do {
	$w++;
} while ($w < 3);

$items = ['x' => 10, 'y' => 20];
foreach ($items as $k => &$v) {
	$v *= 2;
}
unset($v);
echo "Loops: for sum(skip 3)={$sum}, while/do={$w}, foreach ref y={$items['y']}\n";

goto afterGoto;
echo "This line is skipped by goto\n";
afterGoto:
echo "Jumped cleanly with goto!\n";

try {
	throw new Exception("Demo exception");
} catch (Exception $e) {
	echo "Caught exception: " . $e->getMessage() . "\n";
} finally {
	echo "Finally block executed\n";
}

echo "\n=== 6. Functions & Closures ===\n";
if (!function_exists('addWithRef')) {
	function addWithRef(&$target, $default = 1) {
		$target += $default;
		$args = func_get_args();
		for ($i = 2; $i < count($args); $i++) {
			$target += $args[$i];
		}
		return $target;
	}
}
$total = 5;
addWithRef($total, 2, 3, 4);
echo "addWithRef total={$total}\n";

$factor = 3;
$multiplier = function ($n) use ($factor) {
	return $n * $factor;
};
echo "Closure call: " . $multiplier(7) . "\n";

echo "\n=== 7. Classes, Interfaces & OOP ===\n";
if (!class_exists('ShellDevice')) {
	interface Printable {
		public function describe();
	}

	abstract class BaseDevice implements Printable {
		const KIND = 'Terminal';
		public $name;
		public static $count = 0;

		public function __construct($name) {
			$this->name = $name;
			self::$count++;
		}

		abstract public function status();
	}

	class ShellDevice extends BaseDevice {
		public function status() {
			return "ready";
		}

		final public function describe() {
			return static::KIND . ":" . $this->name . " (" . $this->status() . ")";
		}
	}
}

$dev1 = new ShellDevice("WebCLI");
$dev2 = clone $dev1;
echo "OOP: " . $dev2->describe() . ", instanceof Printable=" . (($dev2 instanceof Printable) ? 'true' : 'false') . ", count=" . BaseDevice::$count . "\n";

echo "\n=== 8. BASIC-Style String Functions & sprintf() ===\n";
$sample = "  Hello BOPWebCLI  ";
echo "len('hello')=" . len('hello') . "\n";
echo "left('hello', 2)=" . left('hello', 2) . ", right('hello', 2)=" . right('hello', 2) . "\n";
echo "mid('abcdef', 2, 3)=" . mid('abcdef', 2, 3) . ", instr('banana', 'na')=" . instr('banana', 'na') . "\n";
echo "lower('AbC')=" . lower('AbC') . ", upper('AbC')=" . upper('AbC') . "\n";
echo "chr(65)=" . chr(65) . ", val('  42.5abc')=" . val('  42.5abc') . "\n";
echo "ltrim='" . ltrim($sample) . "', rtrim='" . rtrim($sample) . "'\n";
echo "strcmp('10', '2')=" . strcmp('10', '2') . ", stricmp('BOP', 'bop')=" . stricmp('BOP', 'bop') . "\n";
echo "space: '[" . space(4) . "]'\n";
echo sprintf("sprintf: %s #%03d -> %.2f (hex=%X, char=%c)\n", "Item", 7, 12.345, 255, 65);
echo "split('/[,;]\\s*/'): " . implode('|', split('/[,;]\s*/', 'one, two;three')) . "\n";
echo "split(' ') Perl mode: " . implode('|', split(' ', '  alpha   beta  ')) . "\n";

echo "\n=== 9. Oracle-Style Date & Number Functions ===\n";
echo "sysdate()=" . sysdate() . "\n";
echo "sysdate('DD-MON-YYYY')=" . sysdate('DD-MON-YYYY') . "\n";
$parsedDate = to_date('21-NOV-2026 02:30:00 PM', 'DD-MON-YYYY HH12:MI:SS PM');
echo "to_date=" . $parsedDate . "\n";
echo "to_char(date)=" . to_char($parsedDate, 'Day, Month DD YYYY HH24:MI') . "\n";
echo "to_char(number)=" . to_char(12345.6, '$99,999.99') . "\n";
$tsNum = date_to_number('2026-11-22 12:00:06');
echo "date_to_number('2026-11-22 12:00:06')=" . $tsNum . "\n";
echo "number_to_date(" . $tsNum . ")=" . number_to_date($tsNum) . "\n";
echo "number_to_date(1234123)=" . number_to_date(1234123) . "\n";

echo "\n=== 10. Background Crontab Scheduler (cron) ===\n";
cron(10, "* * * * *", "echo 'cron job 10 tick\n';");
$jobs = cron();
echo "Registered cron job 10 schedule: " . $jobs['10']['schedule'] . "\n";
cron(10, "*/5 * * * *", "echo 'updated job 10\n';");
$jobs = cron();
echo "Updated cron job 10 schedule: " . $jobs['10']['schedule'] . "\n";
cron(10);
echo "Deleted cron job 10, remaining jobs: " . count(cron()) . "\n";

echo "\n=== 11. Browser Runtime & Interactive I/O Bridge ===\n";
$metaEngine = is_array($meta) ? $meta['engine'] : $meta->engine;
$metaEnv = is_array($meta) ? $meta['environment'] : $meta->environment;
echo "Engine=" . $metaEngine . ", Env=" . $metaEnv . ", Bridge v" . $bridge->version . "\n";
// Interactive CLI helpers available at runtime:
//   $name = myinput("Your name: ");
//   $secret = myinput("Secret: ", true);
//   $io->readline("Prompt: ", function($line) use ($term) { $term->echo($line); }, false);
//   $jQuery("body")->css("background", "#111");

echo "\n=== 12. localStorage Virtual Filesystem ===\n";
mkdir('/tmp/demo_dir', 0777, true);
file_put_contents('/tmp/demo_dir/notes.txt', "Line 1\n");
file_put_contents('/tmp/demo_dir/notes.txt', "Line 2\n", FILE_APPEND);
$fh = fopen('/tmp/demo_dir/notes.txt', 'r');
echo "Read via fgets: " . rtrim(fgets($fh)) . " | " . rtrim(fgets($fh)) . "\n";
fclose($fh);
echo "Directory listing: " . implode(', ', scandir('/tmp/demo_dir')) . "\n";
unlink('/tmp/demo_dir/notes.txt');
rmdir('/tmp/demo_dir');

echo "\n=== 13. Standard Math Functions & Constants ===\n";
echo "M_PI=" . round(M_PI, 5) . ", sqrt(144)=" . sqrt(144) . ", pow(2, 8)=" . pow(2, 8) . "\n";
echo "abs(-9.5)=" . abs(-9.5) . ", floor(3.8)=" . floor(3.8) . ", ceil(3.2)=" . ceil(3.2) . "\n";
echo "min(4, 1, 9)=" . min(4, 1, 9) . ", max(4, 1, 9)=" . max(4, 1, 9) . ", hypot(3, 4)=" . hypot(3, 4) . "\n";
echo "sin(deg2rad(30))=" . round(sin(deg2rad(30)), 4) . ", log(64, 2)=" . log(64, 2) . "\n";
echo "decbin(42)=" . decbin(42) . ", base_convert('ff', 16, 2)=" . base_convert('ff', 16, 2) . "\n";

echo "\n=== 14. Standard Array Functions ===\n";
$nums = range(1, 5);
echo "range(1, 5) sum=" . array_sum($nums) . ", product=" . array_product($nums) . "\n";
echo "array_slice=" . implode(',', array_slice($nums, 1, 3)) . ", reversed=" . implode(',', array_reverse($nums)) . "\n";
$pairs = array_combine(['a', 'b', 'c'], [30, 10, 20]);
ksort($pairs);
echo "ksort keys=" . implode(',', array_keys($pairs)) . ", first=" . array_key_first($pairs) . ", last=" . array_key_last($pairs) . "\n";
$users = [['id' => 1, 'name' => 'Ada'], ['id' => 2, 'name' => 'Linus']];
echo "array_column=" . implode(',', array_column($users, 'name')) . "\n";

echo "\n=== 15. Simulated SQLite3 / PDO Database (Zero-WASM) ===\n";
$memDb = new SQLite3(':memory:');
$memDb->exec('CREATE TABLE items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, qty INT)');
$memDb->exec("INSERT INTO items (name, qty) VALUES ('Keyboard', 3), ('Mouse', 7)");
$itemRow = $memDb->querySingle("SELECT name, qty FROM items WHERE qty > 5", true);
echo "SQLite3 query: " . $itemRow['name'] . " x" . $itemRow['qty'] . "\n";
$memDb->close();

$pdoMem = new PDO('sqlite::memory:');
$pdoMem->exec('CREATE TABLE logs (id INTEGER PRIMARY KEY AUTOINCREMENT, msg TEXT)');
$insStmt = $pdoMem->prepare('INSERT INTO logs (msg) VALUES (?)');
$insStmt->execute(['boot ok']);
echo "PDO count: " . $pdoMem->query('SELECT COUNT(*) FROM logs')->fetchColumn() . "\n";

echo "\n=== 16. Screen Dimensions & 2D Cursor Positioning ===\n";
echo "Screen size: " . screen_columns() . " columns x " . screen_lines() . " lines\n";
// Interactive 2D screen mode helpers:
//   screen_mode(true);          // switch to full-screen 2D character grid
//   cls();                      // clear screen / reset cursor to (1,1)
//   locate(5, 10); echo "Hi!";  // BASIC-style (row, col)
//   gotoxy(10, 6); echo "OK";   // X/Y-style (col, row)
//   screen_mode(false);         // return to REPL (or press ESC)
//   $includeBop('screen_demo.bop'); // full interactive screen demo

echo "\n=== 17. Introspection: get_defined_functions() ===\n";
$definedFns = get_defined_functions();
echo "Internal functions: " . count($definedFns['internal']) . ", User functions: " . count($definedFns['user']) . "\n";
echo "User functions: " . implode(', ', $definedFns['user']) . "\n";

echo "\n=== 18. Built-in Test Suites ===\n";
include 'unit_test_string.bop';
include 'unit_test_date.bop';
include 'unit_test_cron.bop';
include 'unit_test_file.bop';
include 'unit_test_math.bop';
include 'unit_test_array.bop';
include 'unit_test_sqlite.bop';
include 'unit_test_screen.bop';

echo "\nDone! Try running individual snippets right at the bop > prompt.\n";
