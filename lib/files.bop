if (!function_exists('basename')) {
	function basename($path, $suffix = '') {
		$p = str_replace('\\', '/', (string) $path);
		$p = rtrim($p, '/');
		if ($p === '') {
			return '';
		}
		$pos = strrpos($p, '/');
		$base = $pos === false ? $p : substr($p, $pos + 1);
		$suf = (string) $suffix;
		if ($suf !== '' && len($base) >= len($suf)) {
			if (substr($base, -len($suf)) === $suf) {
				$base = substr($base, 0, len($base) - len($suf));
			}
		}
		return $base;
	}
}

if (!function_exists('realpath')) {
	function realpath($path) {
		global $bridge;
		return $bridge->vfsRealpath((string) $path);
	}
}

if (!function_exists('pwd')) {
	function pwd() {
		global $bridge;
		return $bridge->vfsGetCwd();
	}
}

if (!function_exists('cd')) {
	function cd($directory = '/') {
		global $bridge;
		$target = ($directory === null || $directory === '') ? '/' : (string) $directory;
		return $bridge->vfsChdir($target);
	}
}

if (!function_exists('ls')) {
	function ls($path = null, $long = false) {
		$target = ($path === null || $path === '') ? pwd() : (string) $path;

		if (strpos($target, '*') !== false || strpos($target, '?') !== false || strpos($target, '[') !== false) {
			$matches = glob($target);
			if ($matches === false) {
				return false;
			}
			if (!$long) {
				return $matches;
			}
			$rows = [];
			foreach ($matches as $m) {
				$full = realpath($m);
				$isDir = $full !== false ? is_dir($full) : is_dir($m);
				$rows[] = [
					'name' => $m,
					'type' => $isDir ? 'dir' : 'file',
					'size' => $isDir ? 0 : (int) filesize($m),
					'mtime' => (int) filemtime($m),
				];
			}
			return $rows;
		}

		if (is_file($target)) {
			$full = realpath($target);
			$name = basename($full !== false ? $full : $target);
			if (!$long) {
				return [$name];
			}
			return [[
				'name' => $name,
				'type' => 'file',
				'size' => (int) filesize($target),
				'mtime' => (int) filemtime($target),
			]];
		}

		if (!is_dir($target)) {
			return false;
		}

		$entries = scandir($target);
		if ($entries === false) {
			return false;
		}

		$baseDir = realpath($target);
		$prefix = ($baseDir === false || $baseDir === '/') ? '/' : ($baseDir . '/');
		$out = [];
		foreach ($entries as $entry) {
			if ($entry === '.' || $entry === '..') {
				continue;
			}
			if (!$long) {
				$out[] = $entry;
			} else {
				$full = $prefix . $entry;
				$isDir = is_dir($full);
				$out[] = [
					'name' => $entry,
					'type' => $isDir ? 'dir' : 'file',
					'size' => $isDir ? 0 : (int) filesize($full),
					'mtime' => (int) filemtime($full),
				];
			}
		}
		return $out;
	}
}

if (!function_exists('cat')) {
	function cat($filename, $return = false) {
		global $bridge;
		$path = (string) $filename;
		if ($path === '') {
			trigger_error("cat: empty filename", E_USER_WARNING);
			return false;
		}
		if (is_dir($path)) {
			trigger_error("cat: " . $path . ": Is a directory", E_USER_WARNING);
			return false;
		}
		$content = $bridge->readTextFile($path);
		if ($content === false) {
			trigger_error("cat: " . $path . ": No such file or directory", E_USER_WARNING);
			return false;
		}
		if ($return) {
			return $content;
		}
		echo $content;
		if (len($content) > 0 && substr($content, -1) !== "\n") {
			echo "\n";
		}
		return true;
	}
}

