<?bop
// Core interactive shell helpers loaded by config.bop.
// Startup banner, self-tests, and login prompts now live in /config.bop and /autoexec.bop.

if (!function_exists('myinput')) {
	function myinput($arg1, $secret = false) {
		global $io;
		return $io->read($arg1, $secret);
	}
}

if (!function_exists('prompt')) {
	function prompt($text = null) {
		global $bridge;
		if ($text === null) {
			return $bridge->getPrompt();
		}
		$p = $bridge->setPrompt((string) $text);
		putenv('PROMPT=' . $p);
		return $p;
	}
}

if (!function_exists('set')) {
	// MS-DOS style SET helper:
	//   set()            -> returns associative array of all environment variables
	//   set('KEY=VALUE') -> sets environment variable KEY to VALUE
	//   set('KEY')       -> returns value of KEY (or false if unset)
	function set($expr = null) {
		if ($expr === null) {
			return getenv();
		}
		$s = (string) $expr;
		if (strpos($s, '=') !== false) {
			return putenv($s);
		}
		return getenv($s);
	}
}

if (!function_exists('reboot')) {
	// Re-executes /config.bop followed by /autoexec.bop (MS-DOS warm reboot)
	function reboot() {
		global $bridge;
		return $bridge->reboot();
	}
}
