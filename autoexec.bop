echo "           V:::V           P::::::::P          S:::::::::::::::SS \n";
echo "            VVV            PPPPPPPPPP           SSSSSSSSSSSSSSS   \n";

// 3. Startup Self-Test Suite (toggle via BOP_RUN_TESTS in config.bop)
if (getenv('BOP_RUN_TESTS') !== '0') {
	$unit_test_verbose = true;
	include 'test/unit_test_string.bop';
	include 'test/unit_test_date.bop';
	include 'test/unit_test_cron.bop';
	include 'test/unit_test_file.bop';
	include 'test/unit_test_math.bop';
	include 'test/unit_test_array.bop';
	include 'test/unit_test_sqlite.bop';
	include 'test/unit_test_screen.bop';
	include 'test/unit_test_sound.bop';
	include 'test/unit_test_preprocessor.bop';
	include 'test/unit_test_boot.bop';
	unset($unit_test_verbose);
}

// 4. Interactive Login Prompt (toggle via BOP_LOGIN_PROMPT in config.bop)
if (getenv('BOP_LOGIN_PROMPT') !== '0') {
	$loginname = myinput("Login:");
	if ($loginname !== null && $loginname !== '') {
		putenv('USER=' . $loginname);
	}
	echo "hello " . $loginname . "\n";

	$passwd = myinput("password:", true);
	if ($passwd !== null && $passwd !== '') {
		putenv('PASSWORD_HASH=' . password_hash($passwd));
		echo "Password hashed and stored in PASSWORD_HASH (verify with password_verify()).\n";
	}
	unset($passwd);
}
